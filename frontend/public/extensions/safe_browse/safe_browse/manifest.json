{
  "manifest_version": 3,
  "name": "Safe Browsing Guard",
  "version": "1.0",
  "description": "Warns you before visiting known malicious or suspicious websites",
  "permissions": ["webNavigation", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
